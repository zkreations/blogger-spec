{
  "name": "@bloggerspec/render",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "BIR v2 to HTML rendering engine for Blogger XML templates.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bloggerspec/spec": "workspace:*"
  },
  "devDependencies": {
    "@bloggerspec/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
