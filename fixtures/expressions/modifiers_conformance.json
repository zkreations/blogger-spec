        "subsystem:subtype_modifiers",
        "modifier:jsEscaped",
        "type:string"
      ],
      "input": {
        "kind": "expression",
        "source": "data:post.title.jsEscaped",
        "context": {
          "post": {
            "title": "Hello 'World'"
          }
        }
      },
      "expected": {
        "outcome": "value",
        "value": "Hello \\'World\\'"
      },
      "verified_at": "2026-10-17"
