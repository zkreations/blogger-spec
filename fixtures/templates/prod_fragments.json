          }
        }
      },
      "expected": {
        "outcome": "html",
        "html": "<article class=\"card\"><img src=\"https://blogger.googleusercontent.com/img/a/AVvXsEjxyz=w300-h300-p-k-no-nu\" alt=\"Hamlet Theme Release\"/><h2 class=\"card-title\">Hamlet Theme Release</h2><p class=\"card-snippet\">Modern responsive Blogger XML template engine.</p></article>",
        "canonicalDom": true
      },
      "verified_at": "2026-10-28"
    },
    {
      "id": "templates/prod_fragments/dom_hoisting",
      "title": "Continuous DOM Mutation Hoisting with Void Element",
      "evidence": "official",
      "covers": [
        "subsystem:prod_fragments",
        "tag:b:tag",
        "tag:b:class",
        "tag:b:attr"
      ],
      "input": {
        "kind": "template",
        "source": "<div class='card'><b:class cond='data:isFeatured' name='card-featured'/><b:attr name='id' expr:value='data:customId'/><b:tag cond='data:useHeader' name='header'><h1>Title</h1></b:tag><b:tag name='input'><b:attr name='b:whitespace' value='remove'/><b:attr name='type' value='text'/><b:class name='field-input'/><b:attr name='value' expr:value='data:inputValue'/></b:tag></div>",
        "mode": "fragment",
        "context": {
          "isFeatured": true,
          "customId": "lead-input",
          "useHeader": false,
          "inputValue": "Draft Content"
        }
      },
      "expected": {
        "outcome": "html",
        "html": "<div class=\"card card-featured\" id=\"lead-input\"><h1>Title</h1><input type=\"text\" class=\"field-input\" value=\"Draft Content\"/></div>",
        "canonicalDom": true
      },
      "verified_at": "2026-10-28"
    },
