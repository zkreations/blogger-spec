{
  "subsystem": "prod_fragments",
  "fixtures": [
    {
      "id": "templates/prod_fragments/byline_render",
      "title": "Production Post Byline Render",
      "evidence": "official",
      "covers": [
        "subsystem:prod_fragments",
        "tag:b:if",
        "tag:data:*"
      ],
      "input": {
        "kind": "template",
        "source": "<div class='byline'><b:if cond='data:show.author'><span class='byline-author'><data:post.author.name/></span></b:if><b:if cond='data:show.comments and data:post.numberOfComments &gt; 0'><span class='byline-comments'><data:post.numberOfComments/> comments</span></b:if></div>",
        "mode": "fragment",
        "context": {
          "show": {
            "author": true,
            "comments": true
          },
          "post": {
            "author": {
              "name": "Blogger Team"
            },
            "numberOfComments": 3
          }
        }
      },
      "expected": {
        "outcome": "html",
        "html": "<div class=\"byline\"><span class=\"byline-author\">Blogger Team</span><span class=\"byline-comments\">3 comments</span></div>",
        "canonicalDom": true
      },
      "verified_at": "2026-10-28"
    },
    {
      "id": "templates/prod_fragments/post_card",
      "title": "Production Post Card with Image Resizing",
      "evidence": "official",
      "covers": [
        "subsystem:prod_fragments",
        "tag:b:if",
        "operator:resizeImage",
        "tag:data:*"
      ],
      "input": {
        "kind": "template",
        "source": "<article class='card'><b:if cond='data:post.featuredImage'><img expr:src='resizeImage(data:post.featuredImage, 300, \"1:1\")' expr:alt='data:post.title'/></b:if><h2 class='card-title'><data:post.title/></h2><p class='card-snippet'><data:post.snippets.short/></p></article>",
        "mode": "fragment",
        "context": {
          "post": {
            "title": "Hamlet Theme Release",
            "featuredImage": "https://blogger.googleusercontent.com/img/a/AVvXsEjxyz=s1600",
            "snippets": {
              "short": "Modern responsive Blogger XML template engine."
