  "fixtures": [
    {
      "id": "rendering/conditional_rendering/if-elseif-else-flow",
      "title": "If Elseif Else Flow",
      "evidence": "official",
      "covers": [
        "subsystem:conditional_rendering",
        "tag:b:if",
        "tag:b:elseif",
        "tag:b:else"
      ],
      "input": {
        "kind": "template",
        "source": "<b:if cond='data:view.isPost'><article>Post Content</article><b:elseif cond='data:view.isPage'/><main>Static Page</main><b:else/><div class='index'>Index Feed</div></b:if>",
        "mode": "fragment",
        "context": {
          "view": {
            "isPost": false,
            "isPage": true
          }
        }
      },
      "expected": {
        "outcome": "html",
        "html": "<main>Static Page</main>",
        "canonicalDom": true
      },
      "verified_at": "2026-10-10"
    },
