{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inclusions.schema.json",
  "title": "Blogger System & Platform Inclusions Master Catalog Schema",
  "description": "JSON Schema specification for platform-level inclusions and backend-resolved subroutines in the Blogger Template Engine.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "domain_metadata",
    "inclusions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "domain_metadata": {
      "type": "object",
      "required": [
        "super_prefix_rule"
      ],
      "properties": {
        "super_prefix_rule": {
          "type": "object",
          "required": [
            "prefix",
            "description",
            "behavior"
          ],
          "properties": {
            "prefix": {
              "type": "string",
              "const": "super."
            },
            "description": {
              "type": "string"
            },
            "behavior": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "standard_diagnostics": {
          "type": "object",
          "properties": {
            "unresolved_inclusion": {
              "$ref": "common.schema.json#/$defs/diagnosticCode"
            },
            "super_inclusion_warning": {
              "$ref": "common.schema.json#/$defs/diagnosticCode"
            },
            "theme_bound_inclusion_warning": {
              "$ref": "common.schema.json#/$defs/diagnosticCode"
            },
            "prohibited_super_includable_override": {
              "$ref": "common.schema.json#/$defs/diagnosticCode"
            }
          },
          "additionalProperties": false
        },
        "super_delegation": {
          "type": "object",
          "properties": {
            "supported_widgets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Widgets supporting super.main delegation to default platform markup."
            },
            "supported_subroutines": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Subroutines supporting super.<name> delegation (e.g. super.postShareButtons)."
            }
          },
          "additionalProperties": false
        },
        "widget_default_inclusions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Registry of canonical default includable subroutine identifiers available per widget type (and 'All') in Blogger's platform rendering engine."
        },
        "local_stubs": {
          "type": "object",
          "description": "Contracts for runtime server assets and placeholders in offline development mode."
        }
      },
      "additionalProperties": false
    },
    "inclusions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/inclusionDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "inclusionDefinition": {
      "type": "object",
      "required": [
        "name",
        "category",
        "description",
        "evidence",
        "verified_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "universal",
            "common",
            "icon",
            "widget",
            "theme",
            "deprecated"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceLevel"
        },
        "deprecated": {
          "$ref": "common.schema.json#/$defs/deprecatedEntry"
        },
        "widget_version": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "Gadget engine version (<b:widget version='1' | '2'>) required when invoked inside a widget."
        },
        "target_widgets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/verified_at"
        },
        "layout_versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Blogger template engine architecture version(s) (b:layoutsVersion='1' | '2' | '3') where this inclusion is available."
        },
        "safety": {
          "type": "string",
          "enum": [
            "portable",
            "theme_bound",
            "internal",
            "deprecated"
          ],
          "description": "Portability and lifecycle safety classification for independent theme development."
        },
        "theme_dependency": {
          "$ref": "#/$defs/inclusionThemeDependency"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inclusionParameter"
          },
          "description": "Parameter contracts accepted by the inclusion via data='...' or context variables."
        },
        "server_markup": {
          "type": "string",
          "description": "Verified server-side XML includable body injected by Blogger's backend rendering engine."
        },
        "local_stub_markup": {
          "type": "string",
          "description": "Normalized, lightweight template markup for offline local compilation."
        }
      },
      "additionalProperties": false
    },
    "inclusionThemeDependency": {
      "type": "object",
      "required": [
        "theme_name",
        "failure_reason"
      ],
      "properties": {
        "theme_name": {
          "type": "string",
          "description": "Name of the official Blogger theme required by this inclusion (e.g. Notable, Emporio)."
        },
        "missing_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Subinclusions, skin variables, or collection structures expected by the backend."
        },
        "failure_reason": {
          "type": "string",
          "description": "Explanation of the compilation or rendering failure when invoked in custom themes."
        }
      },
      "additionalProperties": false
    },
    "inclusionParameter": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Expected data type of parameter."
        },
        "required": {
          "type": "boolean",
          "description": "Whether the parameter must be provided."
        },
        "description": {
          "type": "string",
          "description": "Functional description of the parameter."
        },
        "default": {
          "description": "Default value if parameter is omitted."
        }
      },
      "additionalProperties": false
    }
  }
}
