{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "locales.schema.json",
  "title": "Blogger Locales Master Catalog Schema",
  "description": "JSON Schema specification for Blogger supported locales, RTL/LTR layout alignments, and empirical UI translations across 61 language codes.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "domain_metadata",
    "locales",
    "translations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "domain_metadata": {
      "type": "object",
      "required": [
        "total_locales",
        "default_locale",
        "rtl_locales",
        "evidence",
        "verified_at"
      ],
      "properties": {
        "total_locales": {
          "type": "integer",
          "minimum": 1
        },
        "default_locale": {
          "type": "string"
        },
        "rtl_locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceLevel"
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/verified_at"
        }
      },
      "additionalProperties": false
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/localeRecord"
      }
    },
    "translations": {
      "type": "object",
      "required": [
        "messages",
        "globals",
        "widgets"
      ],
      "properties": {
        "messages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/messageTranslationEntry"
          }
        },
        "globals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/globalTranslationEntry"
          }
        },
        "widgets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/propertyTranslationEntry"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localeRecord": {
      "type": "object",
      "required": [
        "bcp47",
        "underscore_code",
        "name",
        "language",
        "country",
        "script",
        "variant",
        "language_direction",
        "language_alignment"
      ],
      "properties": {
        "bcp47": {
          "type": "string",
          "description": "Standard BCP 47 language tag."
        },
        "underscore_code": {
          "type": "string",
          "description": "Legacy underscore-delimited Blogger locale code."
        },
        "name": {
          "type": "string",
          "description": "Localized or English display name of the locale."
        },
        "language": {
          "type": "string",
          "description": "ISO 639-1 two-letter language subtag."
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 or UN M.49 region code."
        },
        "script": {
          "type": "string",
          "description": "ISO 15924 four-letter script subtag."
        },
        "variant": {
          "type": "string",
          "description": "Language variant subtag if applicable."
        },
        "language_direction": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ],
          "description": "Primary reading and layout direction of the language."
        },
        "language_alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "description": "Primary start alignment corresponding to reading direction."
        }
      },
      "additionalProperties": false
    },
    "messageTranslationEntry": {
      "type": "object",
      "required": [
        "direct_invocation"
      ],
      "properties": {
        "default": {
          "type": "string",
          "description": "Default English value for non-plural message."
        },
        "pattern": {
          "type": "string",
          "description": "ICU plural pattern or un-interpolated template token."
        },
        "direct_invocation": {
          "type": "boolean",
          "description": "Whether direct tag invocation is permitted."
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map of locale code to translated string."
        },
        "plural_forms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": "Map of locale code to plural form cardinalities."
        }
      },
      "additionalProperties": false
    },
    "globalTranslationEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "default",
            "values"
          ],
          "properties": {
            "default": {
              "type": [
                "string",
                "null"
              ]
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sharingPlatformEntry"
          }
        }
      ]
    },
    "sharingPlatformEntry": {
      "type": "object",
      "required": [
        "name",
        "share_message"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/propertyTranslationEntry"
        },
        "share_message": {
          "$ref": "#/$defs/propertyTranslationEntry"
        }
      },
      "additionalProperties": false
    },
    "propertyTranslationEntry": {
      "type": "object",
      "required": [
        "default",
        "values"
      ],
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

