{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "directives.schema.json",
  "title": "Blogger XML Directives & Tags Master Catalog Schema",
  "description": "JSON Schema specification for the Blogger XML directives and tags master catalog.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "directives",
    "domain_metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "directives": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/directiveDefinition"
      }
    },
    "domain_metadata": {
      "type": "object",
      "required": [
        "compiler_limits"
      ],
      "properties": {
        "compiler_limits": {
          "type": "object",
          "required": [
            "max_directive_nesting_depth"
          ],
          "properties": {
            "max_directive_nesting_depth": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "hallucinated_directives": {
          "type": "object",
          "description": "Prohibited or hallucinated directives mapped to their canonical diagnostic code.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^BX[0-9]{4}$"
          }
        },
        "standard_diagnostics": {
          "type": "object",
          "description": "Standard diagnostic codes associated with template syntax and structural violations.",
          "required": [
            "missing_required_attribute",
            "deprecated_attribute",
            "empty_required_attribute",
            "disallowed_expression_attribute",
            "duplicate_element_id",
            "duplicate_includable_id",
            "invalid_variable_type_attribute",
            "prohibited_nesting"
          ],
          "properties": {
            "missing_required_attribute": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "deprecated_attribute": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "empty_required_attribute": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "disallowed_expression_attribute": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "duplicate_element_id": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "duplicate_includable_id": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "invalid_variable_type_attribute": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            },
            "prohibited_nesting": {
              "type": "string",
              "pattern": "^BX[0-9]{4}$"
            }
          },
          "additionalProperties": false
        },
        "theme_designer_descriptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Predefined standard variable description labels supported by Blogger Theme Designer."
        },
        "grammar_groups": {
          "type": "object",
          "description": "Symbolic token groupings for template content models and directive hierarchy validation.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "layout_versions": {
          "type": "object",
          "description": "Canonical Blogger layout versions specifications, activation markers, and heuristics.",
          "required": [
            "supported_versions",
            "default_version",
            "explicit_attributes",
            "versions"
          ],
          "properties": {
            "supported_versions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "default_version": {
              "type": "integer"
            },
            "explicit_attributes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "versions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "version",
                  "name",
                  "description"
                ],
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "structural_markers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "prohibited_markers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "directiveDefinition": {
      "type": "object",
      "required": [
        "category",
        "description",
        "closure_mode",
        "grammar",
        "attributes"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "namespace": {
          "type": "string",
          "enum": [
            "b",
            "data",
            "skin",
            "xml"
          ],
          "description": "XML namespace prefix or syntactic domain for this directive."
        },
        "description": {
          "type": "string"
        },
        "closure_mode": {
          "type": "string",
          "enum": [
            "self_closing",
            "container",
            "dual"
          ],
          "description": "Syntactic closure model: 'self_closing' (must self-close with />), 'container' (requires paired closing tag </...>), or 'dual' (self-closing when unparameterized, container when nesting child tags, e.g. b:message)."
        },
        "self_closing": {
          "type": "boolean",
          "default": false
        },
        "grammar": {
          "$ref": "#/$defs/grammarDefinition"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attributeDefinition"
          }
        },
        "attribute_inversions": {
          "type": "object",
          "description": "Commonly inverted attribute mistakes mapped to their expected attribute name and diagnostic code.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "expected",
              "diagnostic"
            ],
            "properties": {
              "expected": {
                "type": "string"
              },
              "diagnostic": {
                "type": "string",
                "pattern": "^BX[0-9]{4}$"
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "min": {
                "type": "integer"
              },
              "min_cases": {
                "type": "integer"
              },
              "per_parent": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "required_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "workaround": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "deprecated_attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/deprecatedAttributeEntry"
          }
        },
        "spec_extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "output": {
                  "type": "string"
                },
                "syntax": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "syntax_patterns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "syntax",
              "description"
            ],
            "properties": {
              "syntax": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "type_attributes": {
          "type": "object",
          "description": "Allowed and mandatory attributes mapped per subtype (e.g. for <Variable>).",
          "additionalProperties": {
            "type": "object",
            "required": [
              "allowed"
            ],
            "properties": {
              "allowed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "grammarDefinition": {
      "type": "object",
      "required": [
        "valid_parents",
        "valid_children"
      ],
      "properties": {
        "valid_parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valid_children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arbitrary_attributes": {
          "type": "boolean"
        },
        "cdata_content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid_nesting_policy": {
          "type": "object",
          "description": "Declarative runtime action and diagnostic code mapped when nesting constraints are violated.",
          "properties": {
            "on_invalid_parent": {
              "type": "object",
              "required": [
                "diagnostic",
                "action"
              ],
              "properties": {
                "diagnostic": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "reject",
                    "strip",
                    "ignore"
                  ]
                }
              },
              "additionalProperties": false
            },
            "on_invalid_child": {
              "type": "object",
              "required": [
                "diagnostic",
                "action"
              ],
              "properties": {
                "diagnostic": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "reject",
                    "strip",
                    "ignore"
                  ]
                },
                "exceptions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "diagnostic",
                      "action"
                    ],
                    "properties": {
                      "diagnostic": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "reject",
                          "strip",
                          "ignore"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "attributeDefinition": {
      "type": "object",
      "required": [
        "type",
        "attribute_kind",
        "expr",
        "description"
      ],
      "properties": {
        "type": {
          "$ref": "types.schema.json#/$defs/directiveAttributeType"
        },
        "attribute_kind": {
          "type": "string",
          "enum": [
            "native_expression",
            "prefixed_expression",
            "static_literal"
          ],
          "description": "Functional compilation classification: 'native_expression' (attribute natively evaluates dynamic expressions in unadorned form; when expr is true, the expr: prefix enables dynamic runtime dereferencing / double-evaluation, e.g. cond, values, value), 'prefixed_expression' (unadorned form evaluates as a static literal; dynamic expression evaluation requires the expr: prefix, e.g. name, value, class), or 'static_literal' (strictly literal value; expr: prefix is strictly prohibited, e.g. id, type, locked)."
        },
        "accepted_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "allow_empty": {
          "type": "boolean",
          "description": "Specifies whether an empty literal string value (e.g. value='') is valid semantics and exempt from empty attribute warnings (e.g. b:attr value='' to remove parent attribute)."
        },
        "expr": {
          "type": "boolean",
          "description": "Specifies whether the 'expr:' dynamic attribute prefix is allowed for this attribute. Must be false for 'static_literal'. Must be true for 'prefixed_expression'. For 'native_expression', true indicates that expr: prefix is supported to enable dynamic dereferencing / runtime double evaluation, while false indicates expr: prefix is forbidden (e.g. b:eval expr where expr:expr is invalid syntax)."
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "description": "Default value for the attribute if omitted."
        },
        "accepted_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deprecatedAttributeEntry": {
      "type": "object",
      "required": [
        "status",
        "action",
        "type",
        "replacement",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "deprecated_in_widget_v2",
            "deprecated_in_layout_v3",
            "ignored_in_layout_v3",
            "obsolete",
            "legacy"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "migrate",
            "remove"
          ]
        },
        "type": {
          "$ref": "types.schema.json#/$defs/directiveAttributeType"
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
