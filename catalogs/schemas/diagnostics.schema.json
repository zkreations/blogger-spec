{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostics.schema.json",
  "title": "Blogger Diagnostics Catalog Schema",
  "description": "JSON Schema specification for the Blogger diagnostics catalog.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/diagnosticRule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "diagnosticRule": {
      "type": "object",
      "required": [
        "code",
        "name",
        "category",
        "severity",
        "message",
        "evidence",
        "verifiedAt"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/diagnosticCode"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "hallucination",
            "syntax",
            "expressions",
            "quota",
            "structure",
            "deprecation",
            "runtime"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceLevel"
        },
        "verifiedAt": {
          "$ref": "common.schema.json#/$defs/verifiedAt"
        }
      },
      "additionalProperties": false
    }
  }
}
