{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "widgets.schema.json",
  "title": "Blogger Widget Unified Master Catalog Schema",
  "description": "JSON Schema specification for the Blogger unified gadget catalog (runtime data and configuration settings).",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "widgets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "widgets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/widgetEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widgetEntry": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "canonical": {
              "type": "object",
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/canonicalProperty"
              }
            },
            "deprecated": {
              "type": "object",
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/deprecatedEntry"
              }
            }
          },
          "additionalProperties": false
        },
        "settings": {
          "type": "object",
          "properties": {
            "canonical": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/canonicalSetting"
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/patternDefinition"
              }
            },
            "deprecated": {
              "type": "object",
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/deprecatedEntry"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "canonicalSetting": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "null",
            "boolean",
            "integer",
            "number"
          ]
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bound_runtime_data": {
          "type": [
            "string",
            "null"
          ]
        },
        "serialization_format": {
          "type": "string",
          "enum": [
            "json"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonicalSetting"
          }
        },
        "item_properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonicalSetting"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
