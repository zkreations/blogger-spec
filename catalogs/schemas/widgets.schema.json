{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "widgets.schema.json",
  "title": "Blogger Widget Data Dictionaries Master Catalog Schema",
  "description": "JSON Schema specification for the Blogger widget data dictionary master catalog.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "widgets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "widgets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/widgetEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widgetEntry": {
      "type": "object",
      "required": [
        "description",
        "canonical"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "canonical": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/canonicalProperty"
          }
        },
        "deprecated": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/deprecatedEntry"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
