{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "widgets.schema.json",
  "title": "Blogger Widget Data Dictionaries Master Catalog Schema",
  "description": "JSON Schema specification for Blogger gadget runtime local data properties (data.*).",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "description",
    "version",
    "domain_metadata",
    "common",
    "widgets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "domain_metadata": {
      "type": "object",
      "required": [
        "layout_versions"
      ],
      "properties": {
        "layout_versions": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Supported Blogger XML template layout syntax versions."
        }
      },
      "additionalProperties": false
    },
    "common": {
      "$ref": "#/$defs/widgetEntry"
    },
    "widgets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/widgetEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widgetEntry": {
      "type": "object",
      "required": [
        "description",
        "canonical",
        "evidence",
        "verified_at"
      ],
      "properties": {
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceLevel"
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/verified_at"
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/canonicalProperty"
          }
        },
        "deprecated": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/deprecatedEntry"
          }
        },
        "warning_diagnostic": {
          "$ref": "common.schema.json#/$defs/diagnosticCode",
          "description": "Optional warning diagnostic code emitted when instantiating this widget."
        }
      },
      "additionalProperties": false
    }
  }
}
