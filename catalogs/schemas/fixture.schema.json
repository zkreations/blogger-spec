{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture.schema.json",
  "title": "Blogger Conformance Fixture Schema",
  "description": "JSON Schema specification for individual Blogger conformance test fixtures and test manifests.",
  "oneOf": [
    {
      "$ref": "#/$defs/fixture"
    },
    {
      "$ref": "#/$defs/fixtureSuite"
    },
    {
      "$ref": "#/$defs/fixtureManifest"
    }
  ],
  "$defs": {
    "fixture": {
      "type": "object",
      "required": [
        "id",
        "title",
        "evidence",
        "verified_at",
        "covers",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceLevel"
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input": {
          "type": "object",
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "expression",
                "template"
              ]
            },
            "source": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "fragment",
                "full_document"
              ]
            },
            "context": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "value",
                "html",
                "rejected"
              ]
            },
            "value": {},
            "html": {
              "type": "string"
            },
            "canonicalDom": {
              "type": "boolean"
            },
            "diagnosticCodes": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/diagnosticCode"
              }
            },
            "stage": {
              "type": "string",
              "enum": [
                "parser",
                "compiler",
                "quota",
                "linter"
              ]
            }
          },
          "additionalProperties": false
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/verified_at"
        }
      },
      "additionalProperties": false
    },
    "fixtureSuite": {
      "type": "object",
      "required": [
        "subsystem",
        "fixtures"
      ],
      "properties": {
        "subsystem": {
          "type": "string"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          }
        }
      },
      "additionalProperties": false
    },
    "fixtureManifest": {
      "type": "object",
      "required": [
        "version",
        "fixtures"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "generatedAt": {
          "$ref": "common.schema.json#/$defs/verified_at"
        },
        "metrics": {
          "type": "object",
          "required": [
            "totalFixtures",
            "positiveFixtures",
            "negativeFixtures",
            "coveredSpecEntities"
          ],
          "properties": {
            "totalFixtures": {
              "type": "integer",
              "minimum": 0
            },
            "positiveFixtures": {
              "type": "integer",
              "minimum": 0
            },
            "negativeFixtures": {
              "type": "integer",
              "minimum": 0
            },
            "coveredSpecEntities": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
