          "supported_types": [
            "string",
            "color",
            "font",
            "length",
            "background",
            "url",
            "automatic"
          ],
          "description": "Evaluates the value of a Theme Designer variable by name, converting dots to underscores (name.replace(/\\./g, '_')). Composite font variables expose sub-properties .family and .size in template expressions."
