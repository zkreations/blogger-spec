{
  "$schema": "./schemas/globals.schema.json",
  "title": "Blogger Global Data Objects Master Catalog",
  "description": "Comprehensive, machine-readable registry of universal and host-scoped data objects in Blogger Layouts v3, categorizing properties into canonical (modern), patterns (dynamic lookups), and deprecated (obsolete or non-functional).",
  "version": "1.0.0",
  "domain_metadata": {
    "root_datasets": [
      "data:blog",
      "data:view",
      "data:messages",
      "data:skin",
      "data:widgets",
      "data:template"
    ],
    "runtime_evaluation_states": {
      "VALUE": {
        "description": "Property exists in the active runtime data dictionary and holds a non-empty scalar value.",
        "in_dictionary": true,
        "boolean_coercion": "value_dependent",
        "html_output_template": "{value}"
      },
      "EMPTY": {
        "description": "Property exists in the active runtime data dictionary with an empty string value (\"\").",
        "in_dictionary": true,
        "boolean_coercion": "falsy",
        "html_output_template": ""
      },
      "MISSING": {
        "description": "Property is omitted from the active runtime data dictionary for the current view or configuration.",
        "in_dictionary": false,
        "boolean_coercion": "falsy",
        "html_output_template": "<!--Can't find substitution for tag [{tag}]-->"
      },
      "NOT_SINGLETON": {
        "description": "Data path resolves to a composite object or array that cannot be directly interpolated via <data:X/>.",
        "in_dictionary": true,
        "boolean_coercion": "truthy",
        "html_output_template": "<!--Substitution is not a singleton for tag [{tag}]-->"
      }
    },
    "views": {
      "homepage": {
        "description": "Root chronological post feed index.",
        "url_patterns": [
          "/"
        ],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "true",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "post_listing": {
        "description": "Paginated subsequent portions of the chronological post feed.",
        "url_patterns": [
          "/search?updated-max={TIMESTAMP}&max-results={N}"
        ],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "true",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "search_query": {
        "description": "Search results feed matching a user query string.",
        "url_patterns": [
          "/search?q={QUERY}"
        ],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "true",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "label_search": {
        "description": "Category/label post listing feed.",
        "url_patterns": [
          "/search/label/{LABEL}"
        ],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "true",
          "isLabelSearch": "true",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "archive_yearly": {
        "description": "Yearly chronological post archive.",
        "url_patterns": [
          "/{YYYY}",
          "/{YYYY}/"
        ],
        "blog_page_type": "archive",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "true",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "archive_monthly": {
        "description": "Monthly chronological post archive.",
        "url_patterns": [
          "/{YYYY}/{MM}",
          "/{YYYY}/{MM}/"
        ],
        "blog_page_type": "archive",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "true",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "archive_weekly_daily": {
        "description": "Weekly or daily chronological post archive route. Empirically resolves with the monthly archive context (view.archive.year and view.archive.month populated, view.archive.day omitted as MISSING).",
        "url_patterns": [
          "/{YYYY}_{MM}_{DD}_archive.html"
        ],
        "blog_page_type": "archive",
        "view_type": "feed",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "true",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "post": {
        "description": "Individual blog post permalink view.",
        "url_patterns": [
          "/{YYYY}/{MM}/{POST_SLUG}.html"
        ],
        "blog_page_type": "item",
        "view_type": "item",
        "flags": {
          "isHomepage": "false",
          "isPost": "true",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "false",
          "isSingleItem": "true"
        }
      },
      "static_page": {
        "description": "Individual standalone static page view.",
        "url_patterns": [
          "/p/{PAGE_SLUG}.html"
        ],
        "blog_page_type": "static_page",
        "view_type": "item",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "true",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "false",
          "isSingleItem": "true"
        }
      },
      "error_404": {
        "description": "HTTP 404 Not Found error page view.",
        "url_patterns": [],
        "blog_page_type": "error_page",
        "view_type": "error",
        "flags": {
          "isHomepage": "false",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "true",
          "isPreview": "missing",
          "isLayoutMode": "missing",
          "isMultipleItems": "false",
          "isSingleItem": "false"
        }
      },
      "preview": {
        "description": "Blogger Theme Designer interactive live preview mode.",
        "url_patterns": [],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "true",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "true",
          "isLayoutMode": "missing",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      },
      "layout_mode": {
        "description": "Blogger Admin Panel 'Layout' drag-and-drop widget management view.",
        "url_patterns": [],
        "blog_page_type": "index",
        "view_type": "feed",
        "flags": {
          "isHomepage": "true",
          "isPost": "false",
          "isPage": "false",
          "isArchive": "false",
          "isSearch": "missing",
          "isLabelSearch": "false",
          "isError": "false",
          "isPreview": "missing",
          "isLayoutMode": "true",
          "isMultipleItems": "true",
          "isSingleItem": "false"
        }
      }
    }
  },
  "objects": {
    "data:view": {
      "cardinality": "singleton",
      "description": "Request routing and page classification state in Layouts v3.",
      "canonical": {
        "isHomepage": {
          "type": "boolean",
          "description": "True when viewing the root blog index (/ or /?m=1)."
        },
        "isPost": {
          "type": "boolean",
          "description": "True when viewing a single post permalink (/{YYYY}/{MM}/{slug}.html)."
        },
        "isPage": {
          "type": "boolean",
          "description": "True when viewing a static standalone page (/p/{slug}.html)."
        },
        "isArchive": {
          "type": "boolean",
          "description": "True when viewing a chronological archive index (/{YYYY} or /{YYYY}/{MM})."
        },
        "isSearch": {
          "type": "boolean",
          "available_in_views": [
            "post_listing",
            "search_query",
            "label_search"
          ],
          "description": "True when viewing paginated post listings, search query results (/search?q=...), or label listings (/search/label/...). Omitted (MISSING) in all other views."
        },
        "isLabelSearch": {
          "type": "boolean",
          "description": "True when viewing a category/label listing (/search/label/{tag})."
        },
        "isError": {
          "type": "boolean",
          "description": "True when the requested URL returns an HTTP 404 Not Found error."
        },
        "isPreview": {
          "type": "boolean",
          "available_in_views": [
            "preview"
          ],
          "description": "True only when the current view is inside the Blogger Theme Designer preview. Omitted (MISSING) in all public blog views."
        },
        "isLayoutMode": {
          "type": "boolean",
          "available_in_views": [
            "layout_mode"
          ],
          "description": "True only when the current view is the 'Layout' section of the Blogger administration panel. Omitted (MISSING) in all public blog views."
        },
        "isMultipleItems": {
          "type": "boolean",
          "description": "True for collection views (homepage, archive, search results, label index)."
        },
        "isSingleItem": {
          "type": "boolean",
          "description": "True for singular content views (isPost or isPage)."
        },
        "title": {
          "type": "string",
          "description": "Contextual page title string (e.g. data:view.title.escaped)."
        },
        "description": {
          "type": "string",
          "description": "Contextual page description for SEO meta tags. Automatically falls back to the general blog description when a post or static page lacks an individual search description."
        },
        "url": {
          "type": "url",
          "description": "Current canonical page URL object (e.g. data:view.url.canonical)."
        },
        "type": {
          "type": "string",
          "allowed_values": [
            "feed",
            "item",
            "error"
          ],
          "description": "View category: 'feed' (multiple items), 'item' (single post/page), or 'error' (404 error page)."
        },
        "postId": {
          "type": "number",
          "available_in_views": [
            "post"
          ],
          "description": "Unique numerical ID of active blog post. Only injected on post views (MISSING on all other views)."
        },
        "pageId": {
          "type": "number",
          "available_in_views": [
            "static_page"
          ],
          "description": "Unique numerical ID of active static page. Only injected on static page views (MISSING on all other views)."
        },
        "featuredImage": {
          "type": "image",
          "available_in_views": [
            "post"
          ],
          "unconfigured_state": "missing",
          "description": "Primary post hero image URL on post views. Omitted (MISSING) on non-post views or when the post contains no images."
        },
        "search": {
          "type": "object",
          "description": "Child container for search query details, labels, and localized notices.",
          "properties": {
            "label": {
              "type": "string",
              "available_in_views": [
                "label_search"
              ],
              "description": "Active category/label filter string on /search/label/{tag}."
            },
            "query": {
              "type": "string",
              "available_in_views": [
                "search_query"
              ],
              "description": "User search query string on /search?q={query}."
            },
            "resultsMessage": {
              "type": "string",
              "available_in_views": [
                "search_query",
                "label_search"
              ],
              "description": "Localized plain-text summary message.",
              "translatable": true,
              "localization_key": "globals.view.search.resultsMessage"
            },
            "resultsMessageHtml": {
              "type": "string",
              "available_in_views": [
                "search_query",
                "label_search"
              ],
              "description": "Localized summary message containing HTML anchor markup.",
              "translatable": true,
              "localization_key": "globals.view.search.resultsMessageHtml"
            }
          }
        },
        "archive": {
          "type": "object",
          "description": "Child container for chronological archive date filters.",
          "properties": {
            "day": {
              "type": "number",
              "unconfigured_state": "missing",
              "description": "Archive day integer (1-31). Empirically omitted (MISSING) in current Blogger archive routes, including /YYYY_MM_DD_archive.html."
            },
            "month": {
              "type": "number",
              "available_in_views": [
                "archive_monthly",
                "archive_weekly_daily"
              ],
              "description": "Archive month integer (1-12; MISSING on yearly archive views)."
            },
            "year": {
              "type": "number",
              "available_in_views": [
                "archive_yearly",
                "archive_monthly",
                "archive_weekly_daily"
              ],
              "description": "Archive four-digit calendar year integer (e.g. 2026)."
            },
            "rangeMessage": {
              "type": "string",
              "available_in_views": [
                "archive_yearly",
                "archive_monthly",
                "archive_weekly_daily"
              ],
              "description": "Localized chronological period label.",
              "translatable": true,
              "localization_key": "globals.view.archive.rangeMessage"
            }
          }
        }
      },
      "deprecated": {
        "isMobile": {
          "status": "ignored_in_layout_v3",
          "action": "migrate",
          "type": "boolean",
          "replacement": "data:blog.isMobileRequest",
          "reason": "data:view.isMobile is non-functional in responsive v3 themes. Use data:blog.isMobileRequest for URL query detection or CSS media queries for layout.",
          "runtime_state": "active"
        }
      },
      "evidence": "official",
      "verified_at": "2026-10-26"
    },
    "data:blog": {
      "cardinality": "singleton",
      "description": "Global blog metadata, site configurations, locale, and platform asset endpoints.",
      "canonical": {
        "adsenseAutoAds": {
          "type": "boolean",
          "description": "True if AdSense Auto Ads are toggled on in blog settings."
        },
        "adsenseClientId": {
          "type": "string",
          "unconfigured_state": "missing",
          "description": "AdSense publisher ID ('ca-pub-XXXXXXXXXXXXXXXX') linked to the blog."
        },
        "adsenseHasAds": {
          "type": "boolean",
          "description": "True if blog has an approved, active AdSense account."
        },
        "adsenseHostId": {
          "type": "string",
          "unconfigured_state": "missing",
          "description": "Platform host publisher ID ('ca-host-pub-1556223355139109')."
        },
        "adultContent": {
          "type": "boolean",
          "description": "True if adult content warning interstitial is enabled in settings."
        },
        "analytics4": {
          "type": "boolean",
          "unconfigured_state": "missing",
          "condition": "analytics4_configured",
          "description": "True only when a Google Analytics 4 measurement ID (G-XXXXXXXXXX) is configured in blog administration settings. Omitted (MISSING) when unconfigured."
        },
        "analyticsAccountNumber": {
          "type": "string",
          "unconfigured_state": "empty",
          "description": "Google Analytics tracking/property ID (GA4 G-XXXXXXXXXX). Evaluates to empty string '' when unconfigured."
        },
        "bloggerUrl": {
          "type": "url",
          "description": "Blogger platform URL ('https://www.blogger.com')."
        },
        "blogId": {
          "type": "string",
          "description": "Unique numeric identifier for the blog instance."
        },
        "blogspotFaviconUrl": {
          "type": "url",
          "description": "Platform favicon graphic URL for link rel='icon'."
        },
        "dynamicViewsCommentsSrc": {
          "type": "url",
          "description": "Runtime comment script endpoint for Dynamic Views themes."
        },
        "dynamicViewsScriptSrc": {
          "type": "url",
          "description": "Runtime JavaScript endpoint for Dynamic Views themes."
        },
        "enabledCommentProfileImages": {
          "type": "boolean",
          "description": "True if commenter avatar images are enabled in blog settings."
        },
        "encoding": {
          "type": "string",
          "description": "Document character encoding string (evaluates to 'UTF-8')."
        },
        "feedLinks": {
          "type": "string",
          "description": "Auto-discovery RSS/Atom feed link tags."
        },
        "hasCustomDomain": {
          "type": "boolean",
          "description": "True if blog runs on a custom mapped domain rather than blogspot.com."
        },
        "hasCustomJumpLinkMessage": {
          "type": "boolean",
          "description": "True if a custom jump link label was configured in Blog widget settings."
        },
        "homepageUrl": {
          "type": "url",
          "description": "Canonical homepage URL object (data:blog.homepageUrl.canonical)."
        },
        "httpsEnabled": {
          "type": "boolean",
          "description": "True if HTTPS availability and redirect are active."
        },
        "isDynamicViewsAvailable": {
          "type": "boolean",
          "description": "True if Dynamic Views alternate rendering is permitted for the blog."
        },
        "isMobileRequest": {
          "type": "boolean",
          "description": "True if the request explicitly bears the ?m=1 query parameter or mobile user agent."
        },
        "isPrivate": {
          "type": "boolean",
          "description": "True if the blog has restricted reader permissions enabled."
        },
        "isPrivateBlog": {
          "type": "boolean",
          "description": "Semantic alias of isPrivate."
        },
        "jumpLinkMessage": {
          "type": "string",
          "description": "Configured or localized text for the 'Read more' jump link.",
          "translatable": true,
          "localization_key": "globals.blog.jumpLinkMessage",
          "default_value": "Read more"
        },
        "languageDirection": {
          "type": "string",
          "allowed_values": [
            "ltr",
            "rtl"
          ],
          "description": "Text layout direction: 'ltr' or 'rtl'."
        },
        "locale": {
          "type": "locale",
          "description": "BCP 47 language/locale code (e.g. 'en', 'es-419', 'fr'). Can be dynamically overridden in requests via the 'hl' query parameter (e.g. '?hl=ca-ES-VALENCIA')."
        },
        "localeUnderscoreDelimited": {
          "type": "string",
          "description": "Locale formatted with an underscore (e.g. 'en_US'), ideal for Open Graph og:locale meta tags."
        },
        "metaDescription": {
          "type": "string",
          "unconfigured_state": "empty",
          "description": "Meta description string from Settings or individual post/page search description for SEO tags. Evaluates to empty string '' on posts/pages without an individual search description."
        },
        "pageId": {
          "type": "string",
          "available_in_views": [
            "static_page"
          ],
          "description": "Unique numerical ID of active static page (MISSING on non-page views; data:view.pageId preferred in Layouts v3)."
        },
        "pageName": {
          "type": "string",
          "unconfigured_state": "empty",
          "description": "Title of the specific post, page, archive period, or label currently being viewed (empty string '' on homepage, post listings, search queries, and 404 views)."
        },
        "pageTitle": {
          "type": "string",
          "description": "Standardized browser window title combining blog title and page title."
        },
        "pageType": {
          "type": "string",
          "allowed_values": [
            "index",
            "item",
            "static_page",
            "archive",
            "error_page"
          ],
          "description": "Contextual view category: 'index', 'item', 'static_page', 'archive', or 'error_page'."
        },
        "postId": {
          "type": "string",
          "available_in_views": [
            "post"
          ],
          "description": "Unique numerical ID of active blog post (MISSING on non-post views; data:view.postId preferred in Layouts v3)."
        },
        "postImageThumbnailUrl": {
          "type": "url",
          "available_in_views": [
            "post"
          ],
          "unconfigured_state": "missing",
          "description": "Square thumbnail (s72-c) URL of primary post image on post views."
        },
        "postImageUrl": {
          "type": "url",
          "available_in_views": [
            "post"
          ],
          "unconfigured_state": "missing",
          "description": "Primary hero image URL of active post on post views (data:view.featuredImage preferred in Layouts v3)."
        },
        "searchLabel": {
          "type": "string",
          "available_in_views": [
            "label_search"
          ],
          "description": "Active label filter string on search/label views (data:view.search.label preferred in Layouts v3)."
        },
        "searchQuery": {
          "type": "string",
          "available_in_views": [
            "search_query"
          ],
          "description": "Active query string on search results views (data:view.search.query preferred in Layouts v3)."
        },
        "searchUrl": {
          "type": "url",
          "description": "Search endpoint base URL (e.g. https://example.blogspot.com/search)."
        },
        "sharing": {
          "type": "object",
          "description": "Container for social sharing targets and platforms.",
          "properties": {
            "platforms": {
              "type": "array[object]",
              "description": "List of active social sharing networks.",
              "item_properties": {
                "key": {
                  "type": "string",
                  "description": "Identifier ('facebook', 'twitter', 'pinterest', 'email', 'link')."
                },
                "name": {
                  "type": "string",
                  "description": "Localized display name ('Facebook', 'Twitter', etc.).",
