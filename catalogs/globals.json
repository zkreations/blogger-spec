        },
        "vars": {
          "type": "object",
          "description": "Dictionary of all <Variable> definitions declared within <b:skin> CDATA. In template expressions, dots in variable names are canonically converted to underscores (name.replace(/\\./g, '_')), e.g. theme.spacing.base -> data:skin.vars.theme_spacing_base. Value resolution prefers 'value' over 'default'."
        }
      },
      "patterns": [
        {
          "template": "data:skin.vars.{varName}",
