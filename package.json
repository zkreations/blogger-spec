{
  "name": "blogger-spec",
  "type": "module",
  "version": "0.14.5",
  "packageManager": "pnpm@11.28.5",
  "description": "Canonical single source of truth for the Blogger XML template and expression language specification, types, and conformance fixtures.",
  "author": "Blogger Spec Authors & Contributors",
  "license": "MIT",
  "homepage": "https://github.com/zkreations/blogger-spec#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkreations/blogger-spec.git"
  },
  "bugs": {
    "url": "https://github.com/zkreations/blogger-spec/issues"
  },
  "keywords": [
    "blogger",
    "blogspot",
    "template",
    "specification",
    "ast",
    "schema",
    "linter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs/index.d.ts",
      "default": "./dist/catalogs/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "default": "./dist/parser/index.js"
    },
    "./quota": {
      "types": "./dist/quota.d.ts",
      "default": "./dist/quota.js"
    },
    "./data-path": {
      "types": "./dist/data-path.d.ts",
      "default": "./dist/data-path.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./type-system": {
      "types": "./dist/type-system.d.ts",
      "default": "./dist/type-system.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./schemas/*": "./catalogs/schemas/*",
    "./directives": "./catalogs/directives.json",
    "./operators": "./catalogs/operators.json",
    "./types": "./catalogs/types.json",
    "./widgets": "./catalogs/widgets.json",
    "./settings": "./catalogs/settings.json",
    "./globals": "./catalogs/globals.json",
    "./messages": "./catalogs/messages.json",
    "./scopes": "./catalogs/scopes.json",
    "./diagnostics": "./catalogs/diagnostics.json",
    "./inclusions": "./catalogs/inclusions.json",
    "./fixtures": "./fixtures/index.json",
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./node": {
      "types": "./dist/catalogs/fs-store.d.ts",
      "default": "./dist/catalogs/fs-store.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "DISCLAIMER.md",
    "LICENSE",
    "README.md",
    "catalogs",
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsx src/tooling/build.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:spec": "tsx src/tooling/validate-spec.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
