{
  "name": "@bloggerspec/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "codegen": "turbo run codegen",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "pnpm run codegen && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:spec": "pnpm --filter @bloggerspec/spec run test:spec",
    "check:hermetic": "pnpm --filter @bloggerspec/spec run check:hermetic",
    "verify": "pnpm run check:hermetic && pnpm run test:spec && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:tooling",
    "@bloggerspec/eslint": "workspace:*",
    "@bloggerspec/tsconfig": "workspace:*",
    "eslint": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:"
  }
}
